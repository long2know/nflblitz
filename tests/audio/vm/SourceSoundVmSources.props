<Project>
  <ItemGroup>
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceAudioFunctions.cs"
             Link="Production/Presentation/SourceAudioFunctions.cs" />
  </ItemGroup>
  <Target Name="RequireActualSourceSoundSelector" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceAudioFunctions.cs')"
           Text="Actual frozen SourceAudioFunctions is a required pure Core VM dependency; no stub or omitted selector." />
  </Target>
</Project>
