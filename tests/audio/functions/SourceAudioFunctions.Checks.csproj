<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseSharedCompilation>false</UseSharedCompilation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BlitzSourceRoot Condition="'$(BlitzSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../..</BlitzSourceRoot>
    <AudioDataSource Condition="'$(AudioDataSource)' == ''">$(MSBuildThisFileDirectory)../../../Assets/Scripts/AssetImport/SourceAudioFunctionData.cs</AudioDataSource>
    <AudioFunctionsSource Condition="'$(AudioFunctionsSource)' == ''">$(MSBuildThisFileDirectory)../../../Assets/Scripts/Presentation/SourceAudioFunctions.cs</AudioFunctionsSource>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BlitzSourceRoot)/Assets/Scripts/Contracts/**/*.cs" />
    <Compile Include="$(BlitzSourceRoot)/Assets/Scripts/Gameplay/*.cs" />
    <Compile Include="$(BlitzSourceRoot)/Assets/Scripts/AssetImport/*.cs"
             Exclude="$(BlitzSourceRoot)/Assets/Scripts/AssetImport/SourceAudioFunctionData.cs" />
    <Compile Include="$(BlitzSourceRoot)/Assets/Scripts/Storage/*.cs" />
    <Compile Include="$(BlitzSourceRoot)/Assets/Scripts/Presentation/SourceCinematicModel.cs" />
    <Compile Include="$(BlitzSourceRoot)/Assets/Scripts/Presentation/SourceC2SoundFunctions.cs" />
    <Compile Include="$(BlitzSourceRoot)/Assets/Scripts/Presentation/SourceOriginalAudioFunctions.cs" />
    <Compile Include="$(BlitzSourceRoot)/Assets/Scripts/Runtime/SourceContactComposition.cs" />
    <Compile Include="$(BlitzSourceRoot)/Assets/Scripts/Runtime/SourceC2Composition.cs" />
    <Compile Include="$(AudioDataSource);$(AudioFunctionsSource);Program.cs" />
  </ItemGroup>
</Project>
