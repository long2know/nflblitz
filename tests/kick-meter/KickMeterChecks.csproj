<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BlitzSourceRoot Condition="'$(BlitzSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../</BlitzSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Contracts/**/*.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Gameplay/**/*.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/AssetImport/*.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceCinematicModel.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Runtime/SourceContactComposition.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Runtime/SourceCabinetInput.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Runtime/SourceCabinetInputPlaySelection.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceHudModel.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceHudViewport.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceHudComposer.cs" />
    <Compile Include="../parity/FullKernelInputs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="DisabledCallerChecks.cs" />
    <Compile Include="ReferenceChecks.cs" />
    <Compile Include="LifecycleChecks.cs" />
    <Compile Include="AdditionalChecks.cs" />
  </ItemGroup>
  <Import Project="../audio/vm/SourceSoundVmSources.props" />
  <Import Project="../parity/FullKernelSources.props" />
</Project>
