<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseSharedCompilation>false</UseSharedCompilation>
    <SoundPackagingRoot Condition="'$(SoundPackagingRoot)' == ''">$(MSBuildThisFileDirectory)../../../</SoundPackagingRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(SoundPackagingRoot)Assets/Scripts/Contracts/*.cs" Link="Production/Contracts/%(Filename)%(Extension)" />
    <Compile Include="$(SoundPackagingRoot)Assets/Scripts/AssetImport/*.cs" Link="Production/AssetImport/%(Filename)%(Extension)" />
    <Compile Include="$(SoundPackagingRoot)Assets/Scripts/Gameplay/*.cs" Link="Production/Gameplay/%(Filename)%(Extension)" />
    <Compile Include="$(SoundPackagingRoot)Assets/Scripts/Presentation/SourceAudioFunctions.cs" Link="Production/SourceAudioFunctions.cs" />
    <Compile Include="$(SoundPackagingRoot)Assets/Scripts/Presentation/SourceCinematicModel.cs" Link="Production/SourceCinematicModel.cs" />
    <Compile Include="$(SoundPackagingRoot)Assets/Scripts/Presentation/SourceCinematicPlayback.cs" Link="Production/SourceCinematicPlayback.cs" />
    <Compile Include="$(SoundPackagingRoot)Assets/Scripts/Presentation/SourceImpactShaker.cs" Link="Production/SourceImpactShaker.cs" />
  </ItemGroup>
</Project>
