<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BlitzSourceRoot Condition="'$(BlitzSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../</BlitzSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Contracts/**/*.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Gameplay/**/*.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/AssetImport/*.cs" />
    <Compile Include="../parity/FullKernelInputs.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceCinematicModel.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="NativeBallChecks.cs" />
    <Compile Include="SourceCallerChecks.cs" />
    <Compile Include="SentinelChecks.cs" />
    <Compile Include="GeometryCallerChecks.cs" />
    <Compile Include="CanonicalInputs.cs" />
  </ItemGroup>
  <Import Project="../audio/vm/SourceSoundVmSources.props" />
  <Import Project="../parity/FullKernelSources.props" />
  <Target Name="RequireProductionSources" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Gameplay/SourceCatchGeometry.cs')"
           Text="Actual SourceCatchGeometry is required; no geometry replacement is allowed." />
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Gameplay/SourceBallDriver.cs')"
           Text="Actual ball/catch/pass callers are required, not test implementations." />
  </Target>
</Project>
