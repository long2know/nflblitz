<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <BlitzSourceRoot Condition="'$(BlitzSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../../</BlitzSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Contracts/**/*.cs" Link="Production/Contracts/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Gameplay/SourceClock.cs;$(BlitzSourceRoot)Assets/Scripts/Gameplay/SourceMatchRules.cs;$(BlitzSourceRoot)Assets/Scripts/Gameplay/SourceMatchFlow.cs" Link="Production/Gameplay/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireProductionSources" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Contracts/SourceMatchContracts.cs')"
           Text="Actual source-match contracts are required; no substitute DTOs are allowed." />
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Gameplay/SourceMatchFlow.cs')"
           Text="Actual pure source-match flow is required for enum and captain-slot checks." />
  </Target>
</Project>
