<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <BlitzSourceRoot Condition="'$(BlitzSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../</BlitzSourceRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BlitzFullKernel)' == 'true'">
    <DefineConstants>$(DefineConstants);PARITY_FULL_KERNEL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="ContractChecks.cs" />
    <Compile Include="HostAdapterChecks.cs" />
    <Compile Include="FullKernelInputs.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Contracts/**/*.cs" Link="Production/Contracts/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/AssetImport/*.cs" Link="Production/AssetImport/%(Filename)%(Extension)" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Gameplay/**/*.cs" Link="Production/Gameplay/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireProductionSources" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Gameplay/SourceClock.cs')"
           Text="Actual production SourceClock.cs is required; no substitute clock is allowed." />
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Gameplay/SourceMatchRules.cs')"
           Text="Actual production SourceMatchRules.cs is required; no substitute rules are allowed." />
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Gameplay/SourceMatchFlow.cs')"
           Text="Actual production SourceMatchFlow.cs is required; no substitute flow is allowed." />
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Gameplay/SourceAnimationState.cs')"
           Text="Actual production source animation state is required for the synthetic contract traces." />
  </Target>
</Project>
