<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <WasmBuildNative>false</WasmBuildNative>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RunAOTCompilation)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DefineConstants>$(DefineConstants);SOURCE_PLAYER_AOT_V1</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(RunAOTCompilation)' == 'true'">
    <TrimmerRootAssembly Include="SourcePlayer.Core" />
    <TrimmerRootAssembly Include="SourcePlayer.Browser" />
    <TrimmerRootAssembly Include="System.Runtime.Serialization.Json" />
    <TrimmerRootAssembly Include="System.Runtime.Serialization.Xml" />
    <TrimmerRootAssembly Include="System.Private.DataContractSerialization" />
    <TrimmerRootAssembly Include="System.Text.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="SourcePlayer.Core.csproj" />
    <Compile Include="Browser.cs" />
    <Compile Include="BrowserRecords.cs" />
    <WasmExtraFilesToDeploy Include="wwwroot/index.html" TargetPath="index.html" />
    <WasmExtraFilesToDeploy Include="wwwroot/renderer.js" TargetPath="renderer.js" />
    <WasmExtraFilesToDeploy Include="wwwroot/input.js" TargetPath="input.js" />
    <WasmExtraFilesToDeploy Include="wwwroot/audio.js" TargetPath="audio.js" />
    <WasmExtraFilesToDeploy Include="wwwroot/records.js" TargetPath="records.js" />
  </ItemGroup>
</Project>
