<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <WasmBuildNative>false</WasmBuildNative>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="SourcePlayer.Core.csproj" />
    <Compile Include="Browser.cs" />
    <WasmExtraFilesToDeploy Include="wwwroot/index.html" TargetPath="index.html" />
    <WasmExtraFilesToDeploy Include="wwwroot/main.js" TargetPath="main.js" />
    <WasmExtraFilesToDeploy Include="wwwroot/renderer.js" TargetPath="renderer.js" />
    <WasmExtraFilesToDeploy Include="wwwroot/input.js" TargetPath="input.js" />
  </ItemGroup>
</Project>
