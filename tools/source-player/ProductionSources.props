<Project>
  <PropertyGroup>
    <BlitzSourceRoot Condition="'$(BlitzSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../</BlitzSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Contracts/*.cs" Link="Production/Contracts/%(Filename)%(Extension)" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Gameplay/*.cs" Link="Production/Gameplay/%(Filename)%(Extension)" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/AssetImport/*.cs" Link="Production/AssetImport/%(Filename)%(Extension)" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Runtime/SourceC2Composition.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Runtime/SourceContactComposition.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Runtime/FixedStepBridge.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Runtime/SourceCabinetInput.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Runtime/SourceCabinetInputPlaySelection.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Runtime/SourceInterfacePresentation.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Runtime/SourceSoundVmTransport.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/NormalCameraModel.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceAudioFunctions.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceC2SoundFunctions.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceCinematicModel.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceCinematicPlayback.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceImpactShaker.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceHudViewport.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceHudModel.cs" />
    <Compile Include="$(BlitzSourceRoot)Assets/Scripts/Presentation/SourceHudComposer.cs" />
  </ItemGroup>
  <Target Name="RequireActualProduction" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Gameplay/GameSimulation.cs')"
           Text="Source Player requires the real production GameSimulation, not fixtures or JavaScript physics." />
    <Error Condition="!Exists('$(BlitzSourceRoot)Assets/Scripts/Runtime/SourceC2Composition.cs')"
           Text="Source Player requires the real production C2/M1 factory." />
  </Target>
</Project>
