<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseSharedCompilation>false</UseSharedCompilation>
    <ProductionRoot Condition="'$(ProductionRoot)' == ''">$(MSBuildThisFileDirectory)../../../</ProductionRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProductionRoot)Assets/Scripts/Contracts/*.cs" />
    <Compile Include="$(ProductionRoot)Assets/Scripts/AssetImport/GeneratedCInitializer.cs" />
    <Compile Include="$(ProductionRoot)Assets/Scripts/AssetImport/PlayerImportPlan.cs" />
    <Compile Include="$(ProductionRoot)Assets/Scripts/AssetImport/GeneratedPlayerReader.cs" />
    <Compile Include="$(ProductionRoot)Assets/Scripts/AssetImport/GeneratedPlayerData.cs" />
    <Compile Include="$(ProductionRoot)Assets/Scripts/AssetImport/BindPoseMeshBuilder.cs" />
    <Compile Include="$(ProductionRoot)Assets/Scripts/AssetImport/AuthorizedAssetFiles.cs" />
    <Compile Include="$(ProductionRoot)Assets/Scripts/AssetImport/SourcePlayerPose.cs" />
    <Compile Include="$(ProductionRoot)Assets/Scripts/AssetImport/SourceAnimationLibrary.cs" />
    <Compile Include="$(ProductionRoot)Assets/Scripts/AssetImport/SourceAnimationSampling.cs" />
    <Compile Include="$(ProductionRoot)Assets/Scripts/AssetImport/SourceActorPoseSampler.cs" />
  </ItemGroup>
</Project>
