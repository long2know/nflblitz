# A runtime build receives only the exported player and its small HTTP host.
**
!Dockerfile
!.dockerignore
!hosting/
hosting/**
!hosting/nginx.conf
!hosting/entrypoint.sh
!scripts/
scripts/**
!scripts/verify-webgl.sh
!Build/
Build/**
!Build/WebGL/
!Build/WebGL/**

# Defense in depth if private/source material is accidentally exported.
**/.git
**/.git/**
**/.squad
**/.squad/**
**/.env
**/.env.*
**/*.ulf
**/*.alf
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.cs
**/*.meta
**/*.log
**/Library
**/Library/**
**/Temp
**/Temp/**
**/node_modules
**/node_modules/**
**/.DS_Store
